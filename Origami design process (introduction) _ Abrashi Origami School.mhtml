.wp-block-audio { box-sizing: border-box; }

.wp-block-audio figcaption { margin-bottom: 1em; margin-top: 0.5em; }

.wp-block-audio audio { min-width: 300px; width: 100%; }

.wp-block-button__link { box-sizing: border-box; cursor: pointer; display: =
inline-block; text-align: center; word-break: break-word; }

.wp-block-button__link.aligncenter { text-align: center; }

.wp-block-button__link.alignright { text-align: right; }

:where(.wp-block-button__link) { border-radius: 9999px; box-shadow: none; p=
adding: calc(0.667em + 2px) calc(1.333em + 2px); text-decoration: none; }

.wp-block-button[style*=3D"text-decoration"] .wp-block-button__link { text-=
decoration: inherit; }

